APP_NAME=galaxy
APP_CNAME=森罗万象
APP_VERSION=1.0.0
APP_PORT=8888

# 数据库配置
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=galaxy
DATABASE_USER=postgres
DATABASE_PASSWORD=123456

# Redis缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=5000

# 缓存基础配置
CACHE_TYPE=redis
CACHE_TTL=3600
CACHE_KEY_PREFIX=galaxy:

# 缓存策略配置（秒）
CACHE_STRATEGY_SHORT=300
CACHE_STRATEGY_MEDIUM=3600
CACHE_STRATEGY_LONG=86400

# Elasticsearch配置 - 系统仅使用Elasticsearch作为搜索引擎
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT=30000
ELASTICSEARCH_RETRY_COUNT=3
ELASTICSEARCH_SSL=false

# Elasticsearch索引分片和副本配置
ES_INDEX_USER_SHARDS=3
ES_INDEX_USER_REPLICAS=1
ES_INDEX_ORG_SHARDS=3
ES_INDEX_ORG_REPLICAS=1

# 搜索性能配置
SEARCH_MAX_PAGE_SIZE=100
SEARCH_TIMEOUT=5000
SEARCH_MIN_KEYWORD_LENGTH=2
SEARCH_BATCH_SIZE=1000
SEARCH_CONCURRENT_REQUESTS=5

# 用户索引配置
SEARCH_INDEX_USER_ENABLED=true
SEARCH_INDEX_USER_FIELDS=user_name,name,email,phone,department
SEARCH_INDEX_USER_WEIGHT_USERNAME=5
SEARCH_INDEX_USER_WEIGHT_NAME=4
SEARCH_INDEX_USER_WEIGHT_EMAIL=3
SEARCH_INDEX_USER_WEIGHT_PHONE=3
SEARCH_INDEX_USER_WEIGHT_DEPARTMENT=2
SEARCH_INDEX_USER_REALTIME=false

# 组织索引配置
SEARCH_INDEX_ORGANIZATION_ENABLED=true
SEARCH_INDEX_ORGANIZATION_FIELDS=name,description,address,contact
SEARCH_INDEX_ORGANIZATION_WEIGHT_NAME=5
SEARCH_INDEX_ORGANIZATION_WEIGHT_DESCRIPTION=3
SEARCH_INDEX_ORGANIZATION_WEIGHT_ADDRESS=2
SEARCH_INDEX_ORGANIZATION_WEIGHT_CONTACT=3
SEARCH_INDEX_ORGANIZATION_REALTIME=false

# Elasticsearch高级搜索功能
SEARCH_FUZZY_ENABLED=false
SEARCH_FUZZY_SIMILARITY=0.7
SEARCH_SYNONYMS_ENABLED=false
SEARCH_SYNONYM_PATH=synonyms.txt
SEARCH_HIGHLIGHT_ENABLED=true
SEARCH_HIGHLIGHT_PRE_TAG=<em>
SEARCH_HIGHLIGHT_POST_TAG=</em>

# 搜索默认排序
SEARCH_DEFAULT_SORT=relevance

# 日志配置
LOG_LEVEL=info